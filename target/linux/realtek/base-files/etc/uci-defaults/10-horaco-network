#!/bin/sh

. /lib/functions.sh

board=$(board_name)

case "$board" in
horaco,zx-sw82ts-l2p)
	# The 'lan' interface is created by 02_network (board.d)
	# We want to change it to DHCP and add a static fallback alias.
	
	# Try to get the device assigned to lan, fallback to 'br-lan'
	device=$(uci -q get network.lan.device)
	[ -z "$device" ] && device="br-lan"
	
	uci -q batch <<EOF
set network.lan.proto='dhcp'
set network.lan_static=interface
set network.lan_static.proto='static'
set network.lan_static.device='$device'
set network.lan_static.ipaddr='192.168.1.1'
set network.lan_static.netmask='255.255.255.0'
commit network
EOF
	;;
esac

exit 0
