/dts-v1/;

#include "rtl930x.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "horaco,zx-sw82ts-l2p", "realtek,rtl9302d-2x8224-2xge";
	model = "Horaco ZX-SW82TS-L2P / S1300WP-8GT-2S+";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>, <0x20000000 0x10000000>;
	};

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_sys: led-0 {
			label = "green:system";
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};

		/*
		 * Port LEDs are driven by the RTL9302D serial LED controller.
		 * The single RTL8231 on this board is in SHIFT REGISTER MODE
		 * (pin 15/Dis_SMI pulled HIGH to VCC). It has no MDIO interface
		 * and cannot be used as GPIO — it only receives serial LED data
		 * via SI (pin 17) and CLK_IN (pin 18) from the SoC.
		 *
		 * LED[0]-LED[35] = 36 parallel outputs from the RTL8231.
		 * See the led_set node below for per-port LED configuration.
		 * Physical LED[n] → PCB LED mapping requires hardware measurement.
		 */
	};

	/*
	 * LED serial controller configuration for the RTL9302D.
	 *
	 * The SoC serializes per-port link/speed/activity state and shifts
	 * it out to the RTL8231 (in shift register mode) autonomously.
	 *
	 * LED set 0: 8× 2.5G copper ports (MAC 16-23), 3 LEDs each.
	 *   LED0 (green):  2.5G LINK/ACT
	 *   LED1 (yellow): 1G LINK/ACT
	 *   LED2 (amber):  10M/100M LINK/ACT
	 *
	 * LED set 1: 2× SFP+ ports (MAC 26-27), 2 LEDs each.
	 *   LED0 (green):  1G LINK/ACT
	 *   LED1 (yellow): 10G LINK/ACT
	 *
	 * Total bits in serial stream: 8×3 + 2×2 = 28 bits (fits in 36 RTL8231 outputs).
	 *
	 * NOTE: The exact mapping of RTL8231 LED[n] outputs to physical PCB LEDs
	 * has not been verified and requires hardware measurement.
	 */
	led_set {
		compatible = "realtek,rtl9300-leds";
		active-low;

		led_set0 = <(RTL93XX_LED_SET_2P5G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
			    (RTL93XX_LED_SET_1G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
			    (RTL93XX_LED_SET_100M | RTL93XX_LED_SET_10M | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)>;

		led_set1 = <(RTL93XX_LED_SET_1G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
			    (RTL93XX_LED_SET_10G | RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)>;
	};

	i2c-poe {
		compatible = "i2c-gpio";
		scl-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		rtc@51 {
			compatible = "nxp,pcf8563";
			reg = <0x51>;
		};
	};

	/*
	 * SFP 1 (MAC/port 26): connected to SerDes 8 (10gbase-r).
	 *
	 * SFP control signals (tx-disable, mod-def0, los, tx-fault) are on
	 * SoC GPIO or HASIVO MCU GPIO — NOT on the RTL8231 (shift register
	 * mode: no GPIO capability).
	 *
	 * SFP EEPROM I2C: connection unknown. The i2c-ddm.ko DDM driver is
	 * designed for a different board variant using RTL8231 GPIO bit-bang,
	 * which does not apply here.
	 *
	 * TODO: Identify exact SoC GPIO or MCU pins for SFP control signals
	 *       and SFP EEPROM I2C via hardware measurement.
	 */
	sfp_p26: sfp-p26 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0>; /* To be verified */
	};

	/*
	 * SFP 2 (MAC/port 27): connected to SerDes 9 (10gbase-r).
	 *
	 * Same constraints as SFP 1 above.
	 *
	 * TODO: Identify exact SoC GPIO or MCU pins for SFP control signals
	 *       and SFP EEPROM I2C via hardware measurement.
	 */
	sfp_p27: sfp-p27 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1>;  /* To be verified */
	};
};

&i2c_mst1 {
	status = "okay";
	clock-frequency = <100000>;

	i2c0: i2c@0 {
		reg = <0>;
	};

	i2c1: i2c@1 {
		reg = <1>;
	};
};

&uart0 {
	current-speed = <115200>;
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0000000 0x00e0000>;
				read-only;
			};

			partition@e0000 {
				label = "u-boot-env";
				reg = <0x00e0000 0x0010000>;
			};

			partition@f0000 {
				label = "sysinfo";
				reg = <0x00f0000 0x0010000>;
				read-only;
			};

			partition@100000 {
				label = "firmware";
				reg = <0x0100000 0x01f00000>;
			};
		};
	};
};

&ethernet0 {
	status = "okay";
};

&mdio_bus2 {
	status = "okay";

	phy16: ethernet-phy@16 {
		reg = <16>;
		realtek,smi-address = <1>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};

	phy17: ethernet-phy@17 {
		reg = <17>;
		realtek,smi-address = <2>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};

	phy18: ethernet-phy@18 {
		reg = <18>;
		realtek,smi-address = <3>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};

	phy19: ethernet-phy@19 {
		reg = <19>;
		realtek,smi-address = <4>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};

	phy20: ethernet-phy@20 {
		reg = <20>;
		realtek,smi-address = <5>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};

	phy21: ethernet-phy@21 {
		reg = <21>;
		realtek,smi-address = <6>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};

	phy22: ethernet-phy@22 {
		reg = <22>;
		realtek,smi-address = <7>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};

	phy23: ethernet-phy@23 {
		reg = <23>;
		realtek,smi-address = <8>;
		compatible = "ethernet-phy-ieee802.3-c45";
	};
};

&switch0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		/* LAN 1-4: MAC 16-19 → SerDes 6 (QXGMII), LED set 0 */
		port@16 {
			reg = <16>;
			label = "lan1";
			led-set = <0>;
			pcs-handle = <&serdes6>;
			phy-handle = <&phy16>;
			phy-mode = "10g-qxgmii";
		};
		port@17 {
			reg = <17>;
			label = "lan2";
			led-set = <0>;
			pcs-handle = <&serdes6>;
			phy-handle = <&phy17>;
			phy-mode = "10g-qxgmii";
		};
		port@18 {
			reg = <18>;
			label = "lan3";
			led-set = <0>;
			pcs-handle = <&serdes6>;
			phy-handle = <&phy18>;
			phy-mode = "10g-qxgmii";
		};
		port@19 {
			reg = <19>;
			label = "lan4";
			led-set = <0>;
			pcs-handle = <&serdes6>;
			phy-handle = <&phy19>;
			phy-mode = "10g-qxgmii";
		};

		/* LAN 5-8: MAC 20-23 → SerDes 7 (QXGMII), LED set 0 */
		port@20 {
			reg = <20>;
			label = "lan5";
			led-set = <0>;
			pcs-handle = <&serdes7>;
			phy-handle = <&phy20>;
			phy-mode = "10g-qxgmii";
		};
		port@21 {
			reg = <21>;
			label = "lan6";
			led-set = <0>;
			pcs-handle = <&serdes7>;
			phy-handle = <&phy21>;
			phy-mode = "10g-qxgmii";
		};
		port@22 {
			reg = <22>;
			label = "lan7";
			led-set = <0>;
			pcs-handle = <&serdes7>;
			phy-handle = <&phy22>;
			phy-mode = "10g-qxgmii";
		};
		port@23 {
			reg = <23>;
			label = "lan8";
			led-set = <0>;
			pcs-handle = <&serdes7>;
			phy-handle = <&phy23>;
			phy-mode = "10g-qxgmii";
		};

		/* SFP+ 1: MAC 26 → SerDes 8 (10gbase-r), LED set 1 */
		port@26 {
			reg = <26>;
			label = "sfp1";
			led-set = <1>;
			phy-mode = "10gbase-r";
			managed = "in-band-status";
			pcs-handle = <&serdes8>;
			sfp = <&sfp_p26>;
		};

		/* SFP+ 2: MAC 27 → SerDes 9 (10gbase-r), LED set 1 */
		port@27 {
			reg = <27>;
			label = "sfp2";
			led-set = <1>;
			phy-mode = "10gbase-r";
			managed = "in-band-status";
			pcs-handle = <&serdes9>;
			sfp = <&sfp_p27>;
		};

		port@28 {
			reg = <28>;
			label = "cpu";
			ethernet = <&ethernet0>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};
