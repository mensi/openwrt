+static int rtl8224_serdes_config(struct phy_device *phydev)
+{
+	if ((phydev->mdio.addr & 3) != 0)
+		return 0;
+
+	/* Step 1: Set PHY-side SerDes mode to OFF */
+	phy_modify_mmd(phydev, MDIO_MMD_VEND1, RTL8224_VND1_SERDES_MODE,
+		       RTL8224_VND1_SERDES_MODE_MASK,
+		       RTL8224_VND1_SERDES_MODE_OFF);
+
+	/*
+	 * Step 2-7: Apply SDS patch conf (from SDK conf_rtl8224.c).
+	 * Initial values for AM period and opcode are set here, but will be
+	 * overridden below with RTL9300-specific values.
+	 */
+	rtl8224_sds_write(phydev, RTL8224_SDS_AM_PAGE,
+			  RTL8224_SDS_AM_PERIOD_REG, 0x00a4);
+
+	rtl8224_sds_modify(phydev, RTL8224_SDS_NWAY_PAGE,
+			   RTL8224_SDS_NWAY_OPCODE_REG,
+			   RTL8224_SDS_NWAY_OPCODE_MASK, 0x0003);
+
+	rtl8224_sds_modify(phydev, 0x06, 0x03, BIT(15), BIT(15));
+	rtl8224_sds_modify(phydev, 0x06, 0x1d, BIT(9), BIT(9));
+	rtl8224_sds_modify(phydev, 0x06, 0x1f, BIT(13), BIT(13));
+	rtl8224_sds_write(phydev, 0x21, 0x10, 0x4480);
+	rtl8224_sds_write(phydev, 0x21, 0x13, 0x0400);
+	rtl8224_sds_write(phydev, 0x21, 0x18, 0x6d02);
+	rtl8224_sds_write(phydev, 0x21, 0x1b, 0x424e);
+	rtl8224_sds_write(phydev, 0x21, 0x1d, 0x0002);
+	rtl8224_sds_write(phydev, 0x36, 0x1c, 0x1390);
+	rtl8224_sds_write(phydev, 0x2e, 0x04, 0x0080);
+
+	rtl8224_sds_write(phydev, RTL8224_SDS_REG0_TX_PAGE,
+			  RTL8224_SDS_REG0_TX_POST1_REG, 0x0408);
+
+	rtl8224_sds_write(phydev, RTL8224_SDS_REG0_TX_PAGE,
+			  RTL8224_SDS_REG0_TX_REG, 0x020d);
+
+	rtl8224_sds_write(phydev, 0x2e, 0x09, 0x0601);
+
+	rtl8224_sds_write(phydev, RTL8224_SDS_REG0_TX_PAGE,
+			  RTL8224_SDS_REG0_TX_Z0_REG, 0x222c);
+
+	rtl8224_sds_write(phydev, 0x2e, 0x0c, 0xa217);
+	rtl8224_sds_write(phydev, 0x2e, 0x0d, 0xfe40);
+	rtl8224_sds_write(phydev, 0x2e, 0x15, 0xf5f1);
+	rtl8224_sds_write(phydev, 0x2e, 0x16, 0x0443);
+	rtl8224_sds_write(phydev, 0x2e, 0x1d, 0xabb0);
+
+	/*
+	 * RTL9300-specific post-patch overrides (from SDK phy_rtl8224_patch.c
+	 * lines 834-843). The SDS patch above writes non-RTL9300 defaults;
+	 * the SDK then overrides these for RTL9300/RTL9310 platforms.
+	 */
+
+	/* Override opcode to 0xaa (SDK: phy_8224_sdsOpCode_set) */
+	rtl8224_sds_modify(phydev, RTL8224_SDS_NWAY_PAGE,
+			   RTL8224_SDS_NWAY_OPCODE_REG,
+			   RTL8224_SDS_NWAY_OPCODE_MASK, 0x00aa);
+
+	/* Override AM period to 0x5078 (SDK: phy_8224_sdsAmPeriod_set) */
+	rtl8224_sds_write(phydev, RTL8224_SDS_AM_PAGE,
+			  RTL8224_SDS_AM_PERIOD_REG, 0x5078);
+
+	/* Zero all AM markers (SDK: phy_8224_sdsAllAm_set(0x0)) */
+	rtl8224_sds_write(phydev, 0x06, 0x13, 0x0000);
+	rtl8224_sds_write(phydev, 0x06, 0x14, 0x0000);
+	rtl8224_sds_write(phydev, 0x06, 0x15, 0x0000);
+	rtl8224_sds_write(phydev, 0x06, 0x16, 0x0000);
+	rtl8224_sds_write(phydev, 0x06, 0x17, 0x0000);
+	rtl8224_sds_write(phydev, 0x06, 0x18, 0x0000);
+
+	/* Extra USXGMII settings (SDK: phy_8224_sdsExtra_set) */
+	/* Page 0x06, reg 0x11 (TGR_PRO_0_REG17), bit 13 = USXG_V2P1P2_RXOFF */
+	rtl8224_sds_modify(phydev, 0x06, 0x11, BIT(13), BIT(13));
+	/* Page 0x07, reg 0x13 (TGR_PRO_1_REG19), bit 12 = USXG_RXDV_OFF */
+	rtl8224_sds_modify(phydev, 0x07, 0x13, BIT(12), BIT(12));
+
+	/* Step 8-9: Set submode to QXGMII and mode to USXGMII */
+	phy_modify_mmd(phydev, MDIO_MMD_VEND1, RTL8224_VND1_SERDES_MODE,
+		       RTL8224_VND1_SERDES_SUBMODE_MASK,
+		       RTL8224_VND1_SERDES_SUBMODE_10G_QXGMII);
+	phy_modify_mmd(phydev, MDIO_MMD_VEND1, RTL8224_VND1_SERDES_MODE,
+		       RTL8224_VND1_SERDES_MODE_MASK,
+		       RTL8224_VND1_SERDES_MODE_USXGMII);
+
+	/* Step 10: SerDes reset toggle sequence */
+	rtl8224_sds_modify(phydev, 0x20, 0x00, GENMASK(5, 4), 0x30);
+	rtl8224_sds_modify(phydev, 0x20, 0x00, GENMASK(5, 4), 0x10);
+	rtl8224_sds_modify(phydev, 0x20, 0x00, GENMASK(5, 4), 0x30);
+	rtl8224_sds_modify(phydev, 0x20, 0x00, GENMASK(5, 4), 0x00);
+
+	return 0;
+}
+
+static void rtl8224_mdi_reverse(struct phy_device *phydev, u32 val)
+{
+	phy_write_mmd(phydev, MDIO_MMD_VEND1,
+		      RTL8224_VND1_MDI_REVERSE, val);
+}
+
+static void rtl8224_mdi_polarity_swap(struct phy_device *phydev, u32 val)
+{
+	phy_write_mmd(phydev, MDIO_MMD_VEND1,
+		      RTL8224_VND1_MDI_POLARITY_SWAP, val);
+}
+
+static int rtl8224_probe(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	struct rtl8224_priv *priv;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->set_reverse = !of_property_read_u32(dev->of_node, "mdi-reverse",
+						  &priv->mdi_reverse);
+	priv->set_polarity = !of_property_read_u32(dev->of_node, "mdi-polarity",
+						   &priv->mdi_polarity);
+
+	phydev->priv = priv;
+	return 0;
+}
+
+static int rtl8224_config_init(struct phy_device *phydev)
+{
+	int ret;
+	struct rtl8224_priv *priv = phydev->priv;
+
+	ret = rtl8224_serdes_config(phydev);
+	if (ret)
+		return ret;
+
+	if (priv->set_reverse)
+		rtl8224_mdi_reverse(phydev, priv->mdi_reverse);
+
+	if (priv->set_polarity)
+		rtl8224_mdi_polarity_swap(phydev, priv->mdi_polarity);
+
+	return 0;
+}
